{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://connectx-server-production.up.railway.app/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://connectx-server-production.up.railway.app/api/$1"
    }
  ]
}
